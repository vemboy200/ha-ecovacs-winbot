{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "description": "Pick the Winbot to set up. Turn it on first so Home Assistant can hear it.",
        "data": {
          "address": "Robot"
        },
        "data_description": {
          "address": "Winbots Home Assistant can currently hear through a Bluetooth adapter or proxy."
        }
      },
      "bluetooth_confirm": {
        "description": "Set up {name}?"
      }
    },
    "abort": {
      "already_configured": "This Winbot is already set up.",
      "no_devices_found": "No Winbot found. Turn it on, close the ECOVACS HOME app, and make sure it's in range of a Bluetooth adapter or proxy.",
      "not_supported": "This device isn't a supported Winbot."
    },
    "error": {
      "cannot_connect": "Couldn't connect to the Winbot. Make sure it's on, close the ECOVACS HOME app (the robot only accepts one connection), and try again.",
      "unknown": "Unexpected error"
    }
  },
  "entity": {
    "binary_sensor": {
      "attached": {
        "name": "Attached to glass"
      },
      "out_of_water": {
        "name": "Out of water"
      }
    },
    "button": {
      "spray": {
        "name": "Spray"
      }
    },
    "event": {
      "cleaning": {
        "name": "Cleaning",
        "state_attributes": {
          "event_type": {
            "state": {
              "started": "Started",
              "finished": "Done cleaning",
              "returned": "Done returning",
              "interrupted": "Interrupted",
              "error": "Error",
              "out_of_water": "Out of water"
            }
          },
          "source": {
            "name": "Started from",
            "state": {
              "button": "Robot button",
              "app": "App or Home Assistant"
            }
          }
        }
      },
      "bumper": {
        "name": "Bumper",
        "state_attributes": {
          "event_type": {
            "state": {
              "bumped": "Bumped"
            }
          }
        }
      }
    },
    "number": {
      "volume": {
        "name": "Voice volume"
      }
    },
    "sensor": {
      "status": {
        "name": "Status",
        "state": {
          "off": "Off",
          "idle": "Idle",
          "cleaning": "Cleaning",
          "paused": "Paused",
          "returning": "Returning",
          "remote_control": "Remote control"
        }
      },
      "clean_mode": {
        "name": "Cleaning mode",
        "state": {
          "depth": "Deep",
          "auto": "Auto",
          "border": "Edge",
          "spot": "Spot",
          "return": "Return",
          "control": "Remote control"
        }
      },
      "error": {
        "name": "Error code"
      },
      "charge_count": {
        "name": "Charge count"
      },
      "no_water_count": {
        "name": "Out of water count"
      },
      "fall_count": {
        "name": "Fall count"
      },
      "last_trigger": {
        "name": "Last trigger",
        "state": {
          "button": "Robot button",
          "app": "App or Home Assistant",
          "work_complete": "Work complete"
        }
      }
    },
    "switch": {
      "auto_spray": {
        "name": "Automatic spraying"
      },
      "connection": {
        "name": "Bluetooth connection"
      }
    }
  },
  "exceptions": {
    "command_failed": {
      "message": "The Winbot didn't accept the command: {error}"
    },
    "unknown_mode": {
      "message": "Unknown cleaning mode \"{mode}\". Pick one of: {modes}."
    },
    "not_on_glass": {
      "message": "The Winbot isn't attached to the glass."
    }
  },
  "services": {
    "drive": {
      "name": "Drive",
      "description": "Drives the Winbot across the window toward any direction, like the app's joystick. It stops by itself about a second after the drive ends.",
      "fields": {
        "angle": {
          "name": "Direction",
          "description": "Direction on the window in degrees: 0 or 360 up, 90 right, 180 down, 270 left, or anything in between. The robot turns to face it first."
        },
        "speed": {
          "name": "Speed",
          "description": "1 (slow) to 3 (fast)."
        },
        "duration": {
          "name": "Duration",
          "description": "How long to keep driving, in seconds. 0 is a short nudge."
        }
      }
    }
  }
